# pub reads this file in place of .gitignore, so it repeats the
# .gitignore entries that matter for the archive.
.dart_tool/
build/
coverage/
**/doc/api/
/pubspec.lock
example/pubspec.lock

# Generated by `flutter create .` in example/. Consumers regenerate them.
example/android/
example/ios/
example/linux/
example/macos/
example/web/
example/windows/

# Vale prose-lint styles for contributors.
styles/

# README animation, linked from the README by URL. Every package download
# would otherwise carry it.
doc/tour.avif
